# --- Assignment 1 upload rules (2026-10-01) ---
# Python / build
__pycache__/
*.pyc
*.egg-info/
# Hydra run outputs and scratch logs
outputs/
experiments/train_logs/
experiments/*.out
experiments/**/*.log
logs/eval/**/*.log
logs/eval/check/videos/
# smoke / aborted runs
logs/rsl_rl/_smoke/
# training runs: keep params/, git/ diff and TensorBoard events for every run,
# but only the final checkpoint of the runs used in the README (full list below)
logs/rsl_rl/**/model_*.pt
logs/rsl_rl/**/exported/
